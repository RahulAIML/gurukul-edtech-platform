# Google Gemini API key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use for assessment evaluation. Configurable so it can be
# bumped to a newer model without any code changes.
GEMINI_MODEL=gemini-3.5-flash

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=15

# When "true", the /api/assessment/evaluate route returns a deterministic
# mock evaluation instead of calling Gemini — useful for frontend development
# without burning real API quota. Never set true in production.
USE_MOCK_ASSESSMENT_EVALUATION=false
